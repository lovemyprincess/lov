<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
  <meta name="theme-color" content="#08070c">
  <meta name="description" content="Для тебя ❤️">
  <title>Для тебя ❤️</title>
  <style>
    :root {
      --bg: #08070c;
      --text: #fff8fc;
      --accent: #ff6f9f;
    }

    * { box-sizing: border-box; }
    html, body {
      width: 100%;
      height: 100%;
      margin: 0;
      overflow: hidden;
      background: var(--bg);
    }

    body {
      font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    .stage {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      background: #000;
      display: grid;
      place-items: center;
    }

    #film {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: #000;
      cursor: pointer;
      outline: none;
      user-select: none;
      -webkit-user-select: none;
      -webkit-touch-callout: none;
      transition: opacity 900ms cubic-bezier(.22,.61,.36,1);
    }

    .ending {
      position: fixed;
      inset: 0;
      overflow: hidden;
      display: grid;
      place-items: center;
      padding: 24px;
      background:
        radial-gradient(circle at 50% 42%, rgba(112, 43, 88, .24), transparent 34%),
        radial-gradient(circle at 20% 80%, rgba(52, 33, 79, .18), transparent 35%),
        linear-gradient(145deg, #05050a 0%, #0b0710 48%, #130914 100%);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 1.6s ease, visibility 1.6s ease;
    }

    .ending.show {
      opacity: 1;
      visibility: visible;
    }

    .ending::before {
      content: "";
      position: absolute;
      width: 70vmin;
      height: 70vmin;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 102, 155, .07), transparent 68%);
      filter: blur(8px);
      animation: breathe 7s ease-in-out infinite;
    }

    .message {
      position: relative;
      z-index: 2;
      max-width: min(90vw, 720px);
      text-align: center;
      color: var(--text);
      font-size: clamp(30px, 6vw, 64px);
      line-height: 1.18;
      font-weight: 500;
      letter-spacing: -.025em;
      text-wrap: balance;
      opacity: 0;
      transform: translateY(18px) scale(.985);
      filter: blur(5px);
      text-shadow: 0 0 28px rgba(255, 126, 174, .16);
    }

    .show .message {
      animation: reveal 2.2s cubic-bezier(.2,.75,.25,1) 1.05s forwards;
    }

    .heart {
      position: absolute;
      bottom: -12vh;
      left: var(--x);
      z-index: 1;
      width: var(--size);
      height: var(--size);
      opacity: 0;
      transform: translate3d(0, 0, 0) rotate(var(--rot));
      animation: floatUp var(--duration) linear var(--delay) infinite;
      will-change: transform, opacity;
      filter: blur(var(--blur));
    }

    .heart::before {
      content: "♥";
      display: block;
      color: rgba(255, 118, 166, var(--alpha));
      font-size: var(--size);
      line-height: 1;
      text-shadow: 0 0 18px rgba(255, 102, 155, .13);
    }

    @keyframes floatUp {
      0%   { opacity: 0; transform: translate3d(0, 8vh, 0) rotate(var(--rot)) scale(.75); }
      10%  { opacity: var(--peak); }
      78%  { opacity: calc(var(--peak) * .72); }
      100% { opacity: 0; transform: translate3d(var(--drift), -118vh, 0) rotate(calc(var(--rot) + 18deg)) scale(1.05); }
    }

    @keyframes reveal {
      to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
    }

    @keyframes breathe {
      0%, 100% { transform: scale(.92); opacity: .7; }
      50% { transform: scale(1.06); opacity: 1; }
    }

    @media (prefers-reduced-motion: reduce) {
      .ending, #film, .message { transition: none; }
      .heart, .ending::before, .show .message { animation: none; }
      .show .message { opacity: 1; transform: none; filter: none; }
    }
  </style>
</head>
<body>
  <main class="stage" aria-label="Фильм">
    <video
      id="film"
      src="https://pub-8587f8f1e0754212b91fa982417d6fcc.r2.dev/film.mp4"
      playsinline
      webkit-playsinline
      x5-playsinline
      preload="metadata"
      autoplay
      tabindex="0"
      aria-label="Фильм">
    </video>
  </main>

  <section class="ending" id="ending" aria-hidden="true">
    <div class="heart" style="--x:7%;--size:20px;--duration:15s;--delay:-7s;--drift:35px;--rot:-8deg;--alpha:.42;--peak:.58;--blur:.2px"></div>
    <div class="heart" style="--x:15%;--size:13px;--duration:18s;--delay:-12s;--drift:-24px;--rot:12deg;--alpha:.28;--peak:.44;--blur:.3px"></div>
    <div class="heart" style="--x:24%;--size:25px;--duration:16s;--delay:-3s;--drift:42px;--rot:-16deg;--alpha:.32;--peak:.5;--blur:.5px"></div>
    <div class="heart" style="--x:34%;--size:16px;--duration:20s;--delay:-15s;--drift:-32px;--rot:7deg;--alpha:.25;--peak:.4;--blur:.2px"></div>
    <div class="heart" style="--x:43%;--size:12px;--duration:14s;--delay:-5s;--drift:25px;--rot:-5deg;--alpha:.3;--peak:.48;--blur:.1px"></div>
    <div class="heart" style="--x:51%;--size:22px;--duration:19s;--delay:-10s;--drift:-38px;--rot:14deg;--alpha:.34;--peak:.5;--blur:.4px"></div>
    <div class="heart" style="--x:60%;--size:15px;--duration:17s;--delay:-1s;--drift:30px;--rot:-10deg;--alpha:.27;--peak:.42;--blur:.2px"></div>
    <div class="heart" style="--x:68%;--size:27px;--duration:21s;--delay:-13s;--drift:-44px;--rot:5deg;--alpha:.3;--peak:.46;--blur:.5px"></div>
    <div class="heart" style="--x:77%;--size:14px;--duration:16s;--delay:-8s;--drift:28px;--rot:-12deg;--alpha:.3;--peak:.45;--blur:.1px"></div>
    <div class="heart" style="--x:87%;--size:21px;--duration:19s;--delay:-17s;--drift:-30px;--rot:9deg;--alpha:.35;--peak:.52;--blur:.3px"></div>
    <div class="heart" style="--x:94%;--size:12px;--duration:15s;--delay:-4s;--drift:22px;--rot:-4deg;--alpha:.24;--peak:.38;--blur:.2px"></div>
    <div class="message">Спасибо, что ты<br>у меня есть ❤️</div>
  </section>

  <script>
    (() => {
      const video = document.getElementById('film');
      const ending = document.getElementById('ending');

      const showEnding = () => {
        if (ending.classList.contains('show')) return;
        video.style.opacity = '0';
        ending.classList.add('show');
        ending.setAttribute('aria-hidden', 'false');
      };

      // Mobile browsers may block autoplay with sound.
      // We first try normal playback; if blocked, the first tap starts it with sound.
      const tryAutoplay = async () => {
        try {
          video.muted = false;
          await video.play();
        } catch (e) {
          // Browser requires user interaction.
        }
      };

      const startWithSound = async (event) => {
        if (video.ended) return;

        try {
          video.muted = false;
          video.volume = 1;

          if (video.paused) {
            await video.play();
          }
        } catch (e) {
          // Ignore playback errors.
        }
      };

      document.addEventListener('DOMContentLoaded', tryAutoplay, { once: true });
      window.addEventListener('load', tryAutoplay, { once: true });

      // The first tap/click starts the film with sound on mobile.
      video.addEventListener('click', startWithSound);
      video.addEventListener('touchend', startWithSound, { passive: true });

      // Desktop keyboard controls.
      video.addEventListener('keydown', async (event) => {
        if (event.code !== 'Space' && event.code !== 'Enter') return;
        event.preventDefault();

        try {
          video.muted = false;
          if (video.paused) {
            await video.play();
          } else {
            video.pause();
          }
        } catch (e) {}
      });

      video.addEventListener('ended', showEnding);

      video.addEventListener('error', () => {
        setTimeout(() => {
          video.load();
          tryAutoplay();
        }, 1000);
      }, { once: true });
    })();
  </script>
</body>
</html>
